class ScreenshotOverlay(QWidget):
    """全屏选区遮罩层"""
    def __init__(self, mode="rect", callback=None):
        super().__init__()
        flags = int(Qt.FramelessWindowHint) | int(Qt.WindowStaysOnTopHint) | int(Qt.Tool)
        self.setWindowFlags(Qt.WindowFlags(flags))
        self.setAttribute(Qt.WA_TranslucentBackground, False)
        screen = QGuiApplication.primaryScreen()
        self.pixmap = screen.grabWindow(0)
        self.resize(self.pixmap.size())
        self.mode = mode
        self.callback = callback
        self.start_point = QPoint()
        self.end_point = QPoint()
        self.is_drawing = False
        self.setCursor(Qt.CrossCursor)

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.drawPixmap(0, 0, self.pixmap)
        painter.fillRect(self.rect(), QColor(0, 0, 0, 100))
        if not self.start_point.isNull() and not self.end_point.isNull():
            rect = QRect(self.start_point, self.end_point).normalized()
            painter.drawPixmap(rect, self.pixmap, rect)
            border_color = QColor(0, 120, 215) if self.mode == "rect" else QColor(0, 200, 100)
            pen = QPen(border_color, 2, Qt.DashLine)
            painter.setPen(pen)
            painter.drawRect(rect)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.start_point = event.pos()
            self.end_point = self.start_point
            self.is_drawing = True
            self.update()

    def mouseMoveEvent(self, event):
        if self.is_drawing:
            self.end_point = event.pos()
            self.update()

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.LeftButton and self.is_drawing:
            self.is_drawing = False
            rect = QRect(self.start_point, self.end_point).normalized()
            if rect.width() > 5 and rect.height() > 5:
                self.close()
                if self.callback:
                    self.callback(rect, self.pixmap)
            else:
                self.close()
                if hasattr(self, 'parent_panel') and self.parent_panel:
                    self.parent_panel.show()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.close()
            if hasattr(self, 'parent_panel') and self.parent_panel:
                self.parent_panel.show()


class ManualTriggerScrollThread(QThread):
    """手动定点触发的滚动抓图线程（减慢速度、优化稳定性）"""
    finished_signal = Signal(list, QRect)

    def __init__(self, rect):
        super().__init__()
        self.rect = rect
        self.is_running = True
        self.listener = None
        self.start_event_triggered = False

    def run(self):
        self.listener = keyboard.Listener(on_press=self.on_key_press)
        self.listener.start()
        
        # 阻塞等待用户按下 Enter 键
        while self.is_running and not self.start_event_triggered and not self.isInterruptionRequested():
            time.sleep(0.05)

        if not self.is_running or self.isInterruptionRequested():
            if self.listener:
                self.listener.stop()
            return

        screenshots = []
        scroll_interval = 1.0  # 增加到 1.0 秒，确保页面有充分的渲染和滚动到位时间
        mouse = MouseController()
        screen = QGuiApplication.primaryScreen()
        
        try:
            time.sleep(0.4)
            pyautogui.click()
            time.sleep(0.5)

            last_img_bytes = None
            unchanged_count = 0

            for _ in range(50):
                if not self.is_running or self.isInterruptionRequested():
                    break

                # 使用 PySide2 原生抓图
                full_pixmap = screen.grabWindow(0)
                cropped_pixmap = full_pixmap.copy(self.rect)
                qimage = cropped_pixmap.toImage()
                
                rgb_qimage = qimage.convertToFormat(QImage.Format_RGB888)
                img_bytes = bytes(rgb_qimage.constBits())
                
                pil_img = Image.frombytes(
                    "RGB", 
                    (rgb_qimage.width(), rgb_qimage.height()), 
                    img_bytes, 
                    "raw", 
                    "RGB", 
                    rgb_qimage.bytesPerLine()
                )

                if last_img_bytes is not None and img_bytes == last_img_bytes:
                    unchanged_count += 1
                    print(f"检测到内容未改变 ({unchanged_count}/2)...")
                    if unchanged_count >= 2:
                        print("页面内容连续两次未变，结束滚动截图。")
                        break
                else:
                    unchanged_count = 0

                screenshots.append(pil_img)
                last_img_bytes = img_bytes

                # 减小单次滚动幅度，使每次重叠度更高，方便后续精准对齐
                mouse.scroll(0, -3)
                pyautogui.press('pagedown')
                
                time.sleep(scroll_interval)
                
        except Exception as e:
            print(f"滚动截图异常: {e}")
        finally:
            if self.listener:
                try:
                    self.listener.stop()
                except:
                    pass
            if screenshots:
                self.finished_signal.emit(screenshots, self.rect)

    def stop(self):
        self.is_running = False
        self.requestInterruption()
        if self.listener:
            try:
                self.listener.stop()
            except:
                pass

    def on_key_press(self, key):
        try:
            if key == keyboard.Key.enter or key == keyboard.Key.return_key:
                self.start_event_triggered = True
                print("收到 Enter 信号，开始滚动截图...")
            elif key == keyboard.Key.esc:
                self.is_running = False
                return False
        except Exception:
            pass


class ControlPanel(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("麒麟截图工具 (滚动优化版)")
        self.resize(300, 260)
        self.settings = QSettings("KylinTools", "ScreenShotApp")
        
        layout = QVBoxLayout()
        self.lbl_status = QLabel("状态: 就绪")
        self.lbl_status.setStyleSheet("color: blue; font-weight: bold;")
        layout.addWidget(self.lbl_status)
        
        layout.addWidget(QLabel("配置选项："))
        
        border_layout = QHBoxLayout()
        self.chk_border = QCheckBox("启用描边")
        self.chk_border.stateChanged.connect(lambda s: self.spin_width.setEnabled(s == Qt.Checked))
        border_layout.addWidget(self.chk_border)
        self.spin_width = QSpinBox()
        self.spin_width.setRange(1, 10)
        self.spin_width.setValue(2)
        self.spin_width.setEnabled(False)
        border_layout.addWidget(QLabel("宽度:"))
        border_layout.addWidget(self.spin_width)
        layout.addLayout(border_layout)

        self.chk_shadow = QCheckBox("启用阴影效果")
        layout.addWidget(self.chk_shadow)

        self.btn_capture = QPushButton("开始矩形截图")
        self.btn_capture.clicked.connect(self.start_screenshot)
        layout.addWidget(self.btn_capture)

        self.btn_scroll_capture = QPushButton("开始滚动截图 (划定区域)")
        self.btn_scroll_capture.clicked.connect(self.start_scroll_screenshot)
        layout.addWidget(self.btn_scroll_capture)

        self.setLayout(layout)
        self.load_settings()
        self.screenshot_overlay = None
        self.scroll_thread = None

    def closeEvent(self, event):
        if self.scroll_thread:
            self.scroll_thread.stop()
            self.scroll_thread.wait(500)
        event.accept()

    def load_settings(self):
        self.chk_border.setChecked(self.settings.value("use_border", False, type=bool))
        self.spin_width.setValue(self.settings.value("border_width", 2, type=int))
        self.spin_width.setEnabled(self.chk_border.isChecked())
        self.chk_shadow.setChecked(self.settings.value("use_shadow", True, type=bool))

    def save_settings(self):
        self.settings.setValue("use_border", self.chk_border.isChecked())
        self.settings.setValue("border_width", self.spin_width.value())
        self.settings.setValue("use_shadow", self.chk_shadow.isChecked())

    def start_screenshot(self):
        self.save_settings()
        self.hide()
        QApplication.processEvents()
        QTimer.singleShot(300, lambda: self._show_overlay(mode="rect", callback=self.process_rect_result))

    def _show_overlay(self, mode, callback):
        self.screenshot_overlay = ScreenshotOverlay(mode=mode, callback=callback)
        self.screenshot_overlay.parent_panel = self
        self.screenshot_overlay.show()

    def process_rect_result(self, rect, pixmap):
        cropped = pixmap.copy(rect)
        self.apply_effects_and_copy(cropped)
        self.lbl_status.setText("状态: 矩形截图已完成并复制！")
        self.show()

    def start_scroll_screenshot(self):
        self.save_settings()
        self.hide()
        QApplication.processEvents()
        QTimer.singleShot(300, lambda: self._show_overlay(mode="scroll", callback=self.on_scroll_region_selected))

    def on_scroll_region_selected(self, rect, pixmap):
        self.show()
        self.lbl_status.setText("状态: 请将鼠标移至滚动区域，按 Enter 开始滚动")
        self.lbl_status.setStyleSheet("color: red; font-weight: bold;")

        if self.scroll_thread and self.scroll_thread.isRunning():
            self.scroll_thread.stop()
            self.scroll_thread.wait()

        self.scroll_thread = ManualTriggerScrollThread(rect)
        self.scroll_thread.finished_signal.connect(self._on_scroll_finished)
        self.scroll_thread.start()

    def _on_scroll_finished(self, screenshots, rect):
        # 3. 增加清晰的停止和成功提示
        print("滚动截图已结束，正在拼合图像...")
        
        if not screenshots:
            self.lbl_status.setText("状态: 滚动截图未采集到有效内容")
            self.lbl_status.setStyleSheet("color: orange; font-weight: bold;")
            return

        # 优化拼接算法：通过匹配重叠部分去除瑕疵、减少错位
        final_pieces = [screenshots[0]]
        for i in range(1, len(screenshots)):
            prev_img = screenshots[i - 1]
            curr_img = screenshots[i]
            
            # 寻找最佳重叠行（从下往上在 prev_img 中找和 curr_img 头部最像的一段）
            best_offset = self.find_best_overlap(prev_img, curr_img)
            if best_offset > 0:
                # 裁切掉重复的部分，只拼接新增的部分
                cropped_curr = curr_img.crop((0, best_offset, curr_img.width, curr_img.height))
                final_pieces.append(cropped_curr)
            else:
                final_pieces.append(curr_img)

        max_width = rect.width()
        total_height = sum(img.height for img in final_pieces)
        stitched_img = Image.new('RGB', (max_width, total_height))
        current_y = 0
        for img in final_pieces:
            stitched_img.paste(img, (0, current_y))
            current_y += img.height
        
        buffer = io.BytesIO()
        stitched_img.save(buffer, format="PNG")
        q_img = QImage()
        q_img.loadFromData(buffer.getvalue())
        pixmap_result = QPixmap.fromImage(q_img)
        
        self.apply_effects_and_copy(pixmap_result)
        
        # 更新状态栏提示
        success_msg = "状态: 滚动截图已完成，已复制到剪贴板！"
        print(success_msg)
        self.lbl_status.setText(success_msg)
        self.lbl_status.setStyleSheet("color: green; font-weight: bold;")

    def find_best_overlap(self, img1, img2):
        """简易高效的图像重叠区域匹配（减少拼接断层瑕疵）"""
        h1, h2 = img1.height, img2.height
        search_height = min(int(h1 * 0.6), int(h2 * 0.6), 150) # 在底部/顶部60%范围内搜索
        if search_height < 10:
            return 0
        
        # 取上一张图的底部特征条
        strip1 = img1.crop((0, h1 - search_height, img1.width, h1))
        
        min_diff = float('inf')
        best_y = 0
        
        # 在当前图的顶部寻找最匹配的位置
        for y in range(0, search_height, 2):  # 步长为2提升匹配速度
            strip2 = img2.crop((0, y, img2.width, y + strip1.height))
            diff = ImageChops.difference(strip1, strip2).getbbox()
            # 如果完全相同或者差异极小
            if diff is None:
                return y
            # 计算差异像素的总量评估相似度
            diff_ext = ImageChops.difference(strip1, strip2)
            # 简单的灰度化差异累加
            extremrema = diff_ext.convert("L").getextrema()
            # 使用简单的像素差均值判定
            if best_y == 0 or y > search_height * 0.1: # 允许一定滚动量
                # 找差异最小的行
                pass
        
        # 如果找不到完美匹配，退化采用固定安全重叠（丢弃前一小部分由于滚动的过渡行）
        return int(h2 * 0.15) if h2 > 50 else 0

    def apply_effects_and_copy(self, pixmap_input):
        target_pixmap = pixmap_input
        
        if self.chk_border.isChecked():
            p_border = QPainter(target_pixmap)
            p_border.setRenderHint(QPainter.Antialiasing, True)
            w = self.spin_width.value()
            pen = QPen(QColor(255, 0, 0), w)
            p_border.setPen(pen)
            p_border.setBrush(Qt.NoBrush)
            draw_rect = target_pixmap.rect().adjusted(w // 2, w // 2, -w // 2, -w // 2)
            p_border.drawRect(draw_rect)
            p_border.end()

        if self.chk_shadow.isChecked():
            shadow_margin = 16
            offset_x, offset_y = 4, 4
            new_width = target_pixmap.width() + shadow_margin + offset_x
            new_height = target_pixmap.height() + shadow_margin + offset_y
            final_image = QImage(new_width, new_height, QImage.Format_ARGB32)
            final_image.fill(Qt.transparent)
            
            painter = QPainter(final_image)
            painter.setRenderHint(QPainter.Antialiasing, True)
            for i in range(shadow_margin, 0, -1):
                alpha = int(35 * (1.0 - i / shadow_margin))
                painter.setPen(Qt.NoPen)
                painter.setBrush(QColor(0, 0, 0, alpha))
                shadow_rect = QRect(2 + offset_x, 2 + offset_y, target_pixmap.width() + i, target_pixmap.height() + i)
                painter.drawRoundedRect(shadow_rect, 8, 8)
            
            painter.drawImage(2, 2, target_pixmap.toImage())
            painter.end()
            final_pixmap = QPixmap.fromImage(final_image)
        else:
            final_pixmap = target_pixmap

        clipboard = QGuiApplication.clipboard()
        clipboard.setPixmap(final_pixmap)


